<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keys Xcode's generated Info.plist cannot carry: INFOPLIST_KEY_* covers only
  Apple's own keys, so the app target merges this file into the generated one
  (INFOPLIST_FILE, beside GENERATE_INFOPLIST_FILE = YES).

  The cloud-import OAuth clients. These are PUBLIC-client IDs: no secret exists
  for any of the three registrations, and all live in every shipped binary by design
  (docs/design-cloud-import.md §2). A hand-set UserDefaults value of the same
  key still wins, so a dev Mac can point at a test client without a rebuild
  (MicrosoftOAuthConfig.resolve, GoogleOAuthConfig.resolve, ZoomOAuthConfig.resolve).

  Changing an ID strands every tester's stored grant: they must sign in again.
  Zoom's is its PRODUCTION public client ID (App Credentials > Use Public Client
  OAuth), baked when Zoom approved the beta share, 9 Nov 2026: outside accounts
  can sign in, up to 100 installs while the publishable URL lasts (to 7 Dec,
  two 4-week extensions). Its redirect is the HTTPS one in Zoom's allow list,
  backed by bristlenose.app's apple-app-site-association and the
  webcredentials entitlement. Zoom import still shows only with the
  Diagnostics menu on (CloudPlatform.zoomOffered).
  Pinned by BristlenoseTests/OAuthBundledClientIDTests.swift and by both
  artefact gates, desktop/scripts/check-dmg-shippable.sh (the .dmg) and
  desktop/scripts/check-pkg-shippable.sh (the TestFlight .pkg).
-->
<plist version="1.0">
<dict>
	<key>MicrosoftOAuthClientID</key>
	<string>022bacc2-0573-476e-a0aa-8efa42b78a1b</string>
	<key>MicrosoftOAuthRedirectURI</key>
	<string>msauth.app.bristlenose://auth</string>
	<key>GoogleOAuthClientID</key>
	<string>335545742339-qqkuglejbs559lu1imjomvhce83uf2qa.apps.googleusercontent.com</string>
	<key>ZoomOAuthPublicClientID</key>
	<string>5p8ZT9wKRrmm7pHrwsvzWw</string>
	<key>ZoomOAuthRedirectURI</key>
	<string>https://bristlenose.app/auth/zoom</string>
</dict>
</plist>
