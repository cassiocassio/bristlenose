<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.bristlenose</string>
	</array>
	<!-- Background Assets deposits downloaded packs into the App Group
	     container, so the host and the downloader extension must share one.
	     App-wide rather than per-feature on purpose: BAAssetPackManager pools
	     every pack into a single namespace, and Whisper's models are the next
	     customer (docs/design-modularity.md), so a second group would mean a
	     second portal entry and another profile regeneration for nothing.
	     group.app.bristlenose is NOT on the Developer-ID build — see
	     BristlenoseDeveloperID.entitlements. -->
	<!-- The Team-ID-prefixed group carries the MCP handshake for the sandboxed
	     native proxy: a process signed by this team, sandboxed and carrying
	     this group, reads its container whichever app launched it, and macOS 27
	     denies the data container to other teams' readers
	     (docs/design-mcp-native-proxy.md §6). Authorised by the MAS profile's
	     Z56GZVA2QB.* entry. The Developer-ID build carries it too. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.bristlenose</string>
		<string>$(TeamIdentifierPrefix)app.bristlenose</string>
	</array>
	<!-- Zoom's HTTPS sign-in callback: ASWebAuthenticationSession's
	     .https(host:path:) is validated against the webcredentials service
	     specifically. An applinks-only entry fails by HANGING: consent
	     completes and nothing comes back. Served by
	     https://bristlenose.app/.well-known/apple-app-site-association.
	     Store and Debug only; the Developer-ID .dmg does not import from
	     Zoom (docs/design-cloud-import-transcripts.md §1b). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:bristlenose.app</string>
	</array>
</dict>
</plist>
