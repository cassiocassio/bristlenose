<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.bristlenose</string>
	</array>
	<!-- The Team-ID-prefixed group, so a Debug build writes the MCP handshake
	     where the native helper reads it (design-mcp-native-proxy §6.9). Debug
	     signs Apple Development, so its helper is app.bristlenose.mcp.dev,
	     never the store identifier (§6.7). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)app.bristlenose</string>
	</array>
	<!-- Zoom's HTTPS sign-in callback: ASWebAuthenticationSession's
	     .https(host:path:) is validated against the webcredentials service
	     specifically. An applinks-only entry fails by HANGING: consent
	     completes and nothing comes back. Served by
	     https://bristlenose.app/.well-known/apple-app-site-association.
	     Store and Debug only; the Developer-ID .dmg does not import from
	     Zoom (docs/design-cloud-import-transcripts.md §1b). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:bristlenose.app</string>
	</array>
</dict>
</plist>
