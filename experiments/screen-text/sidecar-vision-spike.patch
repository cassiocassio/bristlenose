     # invocation. Must run before any argv manipulation.
+    # SPIKE (screen text): Foundation in an inherited-sandbox child resolves NSHomeDirectory() to the
+    # REAL home, so system frameworks put caches where the sandbox refuses writes (Vision's e5rt
+    # model cache). Point Foundation at the container the host already gave us as HOME.
+    if "/Library/Containers/" in os.environ.get("HOME", ""):
+        os.environ.setdefault("CFFIXED_USER_HOME", os.environ["HOME"])
     import multiprocessing
 
     multiprocessing.freeze_support()
@@ -76,6 +81,9 @@ def main() -> None:
         sys.argv = [sys.argv[0], "serve", *sys.argv[1:]]
     elif sys.argv[1] != "serve":
         sys.argv = [sys.argv[0], "serve", *sys.argv[1:]]
+    if sys.argv[1] == "serve":  # SPIKE (screen text): Vision inside the sandboxed sidecar
+        from bristlenose import _vision_probe_spike
+        _vision_probe_spike.start(sys.argv[2:])
     app()
 
 
