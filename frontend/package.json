{
  "name": "bristlenose-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.export.config.ts",
    "build:export": "vite build --config vite.export.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "size-limit": [
    {
      "name": "Live SPA, English (gzipped)",
      "path": [
        "../bristlenose/server/static/assets/*.js",
        "!../bristlenose/server/static/assets/visual-diff-*.js",
        "!../bristlenose/server/static/assets/ResponsivePlayground-*.js",
        "!../bristlenose/server/static/assets/GridSpecimen-*.js",
        "!../bristlenose/server/static/assets/PlaygroundStore-*.js",
        "!../bristlenose/server/static/assets/PlaygroundHUD-*.js",
        "!../bristlenose/server/static/assets/devicePresets-*.js",
        "!../bristlenose/server/static/assets/HelloIsland-*.js",
        "!../bristlenose/server/static/assets/TranscriptPage-*.js",
        "!../bristlenose/server/static/assets/Toolbar-*.js",
        "!../bristlenose/server/static/assets/QuoteSections-*.js",
        "!../bristlenose/server/static/assets/QuoteThemes-*.js",
        "!../bristlenose/server/static/assets/CodebookPanel-*.js",
        "!../bristlenose/server/static/assets/AnalysisPage-*.js",
        "!../bristlenose/server/static/assets/common-*.js",
        "!../bristlenose/server/static/assets/settings-*.js",
        "!../bristlenose/server/static/assets/desktop-*.js",
        "!../bristlenose/server/static/assets/enums-*.js",
        "!../bristlenose/server/static/assets/cli-*.js",
        "!../bristlenose/server/static/assets/doctor-*.js",
        "!../bristlenose/server/static/assets/pipeline-*.js",
        "!../bristlenose/server/static/assets/preflight-*.js",
        "!../bristlenose/server/static/assets/server-*.js"
      ],
      "limit": "220 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@size-limit/file": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.4.0",
    "size-limit": "^12.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
