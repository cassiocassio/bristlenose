 "quotes": [
  {
   "key": "q0",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 86.54,
   "time": "01:26",
   "text": "I live in a terraced house in Leeds with my partner and our two kids, who are seven and ten, so the fridge empties quickly.",
   "after_item": "s2.1",
   "section": "s2",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q1",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 113.77,
   "time": "01:53",
   "text": "Once a week, usually Sunday evening, and then there's always a top-up shop on Wednesday for milk and bread.",
   "after_item": "s2.2",
   "section": "s2",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q2",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 138.69,
   "time": "02:18",
   "text": "I look at what we've got in the cupboards first, then I plan maybe four dinners and fill in the gaps around those.",
   "after_item": "s3.1",
   "section": "s3",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q3",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 164.38,
   "time": "02:44",
   "text": "Always, there's a shared note on my phone that my partner adds to whenever we run out of something.",
   "after_item": "s3.2",
   "section": "s3",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q4",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 190.08,
   "time": "03:10",
   "text": "Always the phone, paper lists just get lost in my coat pocket and then I'm stood in the kitchen guessing.",
   "after_item": "a1",
   "section": "s3",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q5",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 214.23,
   "time": "03:34",
   "text": "We try to keep it under a hundred and twenty pounds, but it creeps up every month without us really noticing.",
   "after_item": "a2",
   "section": "e1",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q6",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 239.15,
   "time": "03:59",
   "text": "Honestly I just watch the running total in the basket and start taking things out when it goes over a hundred.",
   "after_item": "a3",
   "section": "e1",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q7",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 263.69,
   "time": "04:23",
   "text": "Then the vegetables go off, that's the honest answer, and I feel guilty throwing half a bag of spinach away.",
   "after_item": "s3.4",
   "section": "s3",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q8",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 295.69,
   "time": "04:55",
   "text": "I opened the favourites tab, ticked most of last week's things, then searched for the odd extra like birthday candles.",
   "after_item": "s4.1",
   "section": "s4",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q9",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 318.31,
   "time": "05:18",
   "text": "The candles, actually, I searched three different ways and it kept showing me candle-shaped cake toppers instead.",
   "after_item": "s4.2",
   "section": "s4",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q10",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 340.15,
   "time": "05:40",
   "text": "They make me nervous, last time they swapped oat milk for a chocolate oat drink and my son was delighted but I wasn't.",
   "after_item": "s4.3",
   "section": "s4",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q11",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 365.46,
   "time": "06:05",
   "text": "I book the cheapest one on Sunday night, even if it means unpacking shopping at nine o'clock when I'm exhausted.",
   "after_item": "s5.1",
   "section": "s5",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q12",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 388.85,
   "time": "06:28",
   "text": "Once, when the slots were all gone before Christmas, and the car park pickup was quicker than I expected it to be.",
   "after_item": "s5.2",
   "section": "s5",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q13",
   "session": "s1",
   "participant": "p1",
   "name": "Asha",
   "sec": 415.31,
   "time": "06:55",
   "text": "Let me lock substitutions per item, so the milk is never swapped but the bread can be anything at all.",
   "after_item": "s6.1",
   "section": "s6",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q14",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 69.85,
   "time": "01:09",
   "text": "It's just me and my flatmate in Bristol, we split some things but mostly shop separately for our own meals.",
   "after_item": "s2.1",
   "section": "s2",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q15",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 95.92,
   "time": "01:35",
   "text": "I pick whatever's free after eight, because I'm never home before then and I hate the idea of a missed delivery.",
   "after_item": "s5.1",
   "section": "s5",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q16",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 120.08,
   "time": "02:00",
   "text": "The driver once left everything with a neighbour I'd never met, and the frozen stuff had defrosted by the time I found it.",
   "after_item": "s5.3",
   "section": "s5",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q17",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 145.38,
   "time": "02:25",
   "text": "They refunded the frozen items after I sent photos, but it took two separate chats with the support bot to get there.",
   "after_item": "a4",
   "section": "s5",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q18",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 171.85,
   "time": "02:51",
   "text": "Mostly I follow recipes I've saved, I'll pick three for the week and buy exactly what those need and nothing else.",
   "after_item": "s3.1",
   "section": "s3",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q19",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 196.0,
   "time": "03:16",
   "text": "A free recipe app with a meal planner in it, I've been using it for about two years now and it's full.",
   "after_item": "a5",
   "section": "s3",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q20",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 221.69,
   "time": "03:41",
   "text": "No, I type every ingredient in by hand, which is the most tedious part of the whole weekly routine for me.",
   "after_item": "a6",
   "section": "s4",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q21",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 246.62,
   "time": "04:06",
   "text": "Sometimes I send her a link when I've cooked something good, but she never actually makes any of them.",
   "after_item": "a7",
   "section": "s4",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q22",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 271.54,
   "time": "04:31",
   "text": "I search item by item from the recipe list, which takes ages because the search doesn't understand quantities at all.",
   "after_item": "s4.1",
   "section": "s4",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q23",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 294.54,
   "time": "04:54",
   "text": "I turn them off completely, I'd rather have nothing than the wrong thing turn up when I'm cooking to a recipe.",
   "after_item": "s4.3",
   "section": "s4",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q24",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 319.46,
   "time": "05:19",
   "text": "Yes, I've stopped buying branded pasta and sauces, and I buy meat on the reduced shelf whenever I can find it.",
   "after_item": "a8",
   "section": "e1",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q25",
   "session": "s2",
   "participant": "p2",
   "name": "Ben",
   "sec": 351.08,
   "time": "05:51",
   "text": "Let me paste a whole recipe in and have the app build the basket for me, with the right quantities already worked out.",
   "after_item": "s6.1",
   "section": "s4",
   "how": "topic",
   "sentiment": null
  },
  {
   "key": "q26",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 70.62,
   "time": "01:10",
   "text": "I live with my mum, who doesn't use the internet at all, so I do all of the shopping for both of us now.",
   "after_item": "s2.1",
   "section": "s2",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q27",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 96.69,
   "time": "01:36",
   "text": "Mum tells me what she fancies on Saturday, and I add the basics we always need on top of whatever she's asked for.",
   "after_item": "s3.1",
   "section": "s3",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q28",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 122.77,
   "time": "02:02",
   "text": "Eighty pounds is the limit, because it comes out of mum's pension and she checks the receipt very carefully every week.",
   "after_item": "a2",
   "section": "e1",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q29",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 146.92,
   "time": "02:26",
   "text": "Every single week, I sort by price per kilo and I'll switch brands without a second thought if it saves us money.",
   "after_item": "a9",
   "section": "e1",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q30",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 171.08,
   "time": "02:51",
   "text": "On the fridge, on paper, because mum needs to be able to add things to it herself while I'm out at work.",
   "after_item": "s3.2",
   "section": "s3",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q31",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 196.38,
   "time": "03:16",
   "text": "I'll be honest, I spent most of that order hunting through the offers page, the actual ordering bit was the quick part.",
   "after_item": "s4.1",
   "section": "e1",
   "how": "topic",
   "sentiment": null
  },
  {
   "key": "q32",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 221.69,
   "time": "03:41",
   "text": "Mum's particular brand of decaf tea, it's listed under a different name in the app and it took me ages to find it.",
   "after_item": "s4.2",
   "section": "s4",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q33",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 247.77,
   "time": "04:07",
   "text": "I rejected it at the door, the driver was lovely about it and the refund was on my card the very next morning.",
   "after_item": "a10",
   "section": "s5",
   "how": "topic",
   "sentiment": null
  },
  {
   "key": "q34",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 272.69,
   "time": "04:32",
   "text": "Massively, the same basket is about fifteen pounds more than it was last spring, and mum notices every penny of it.",
   "after_item": "a8",
   "section": "e1",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q35",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 296.85,
   "time": "04:56",
   "text": "Saturday morning, so mum can be up and dressed when the driver comes and help put things away in the right places.",
   "after_item": "s5.1",
   "section": "s5",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q36",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 320.62,
   "time": "05:20",
   "text": "Once it arrived two hours late, which meant mum had to sit waiting by the window all morning, and she was quite upset.",
   "after_item": "s5.3",
   "section": "s5",
   "how": "agree",
   "sentiment": null
  },
  {
   "key": "q37",
   "session": "s3",
   "participant": "p3",
   "name": "Carla",
   "sec": 353.0,
   "time": "05:53",
   "text": "Only that the app should have a simple mode for older people, mum would love to order her own things one day.",
   "after_item": "s6.2",
   "section": "s6",
   "how": "agree",
   "sentiment": null
  }
 ],
