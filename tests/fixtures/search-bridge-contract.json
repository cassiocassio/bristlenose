        "query": "pos",
        "rows": [
          { "id": "sentiment:positive", "kind": "sentiment", "label": "Positive", "typed": [[0, 3]], "count": 9 },
          { "id": "tag:posture", "kind": "tag", "label": "Posture", "typed": [[0, 3]], "count": 2 }
        ]
      },
      "tokens": [
        { "kind": "session", "subject": { "kind": "session", "id": "s2" }, "label": "Session 2", "mode": "in", "modes": [] },
        { "kind": "tag", "subject": { "kind": "tag", "name": "Posture" }, "label": "Posture", "mode": "tagged", "modes": [] }
      ]
