  "native_to_web": {
    "_comment": "`before` is the store's tokens and query; `effect` is what they are afterwards. A payload that names nothing current is ignored.",
    "project": {
      "people": { "p3": { "full_name": "Zoë Ng", "short_name": "Zoë" } },
      "quote_tags": ["Zoning", "Pricing"]
    },
    "cases": [
      {
        "name": "a person row adds a said-by token and clears what was typed",
        "action": "applySearchSuggestion",
        "payload": { "id": "person:p3" },
        "before": { "query": "zo", "tokens": [] },
        "effect": { "query": "", "tokens": [{ "kind": "person", "code": "p3", "names": ["Zoë Ng", "Zoë"], "mode": "said" }] }
      },
      {
        "name": "a tag row adds a tagged token, spelt as the project spells it",
        "action": "applySearchSuggestion",
        "payload": { "id": "tag:zoning" },
        "before": { "query": "zon", "tokens": [] },
        "effect": { "query": "", "tokens": [{ "kind": "tag", "name": "Zoning", "mode": "tagged" }] }
      },
      {
        "name": "the free-text row leaves the query as typed",
        "action": "applySearchSuggestion",
        "payload": { "id": "text" },
        "before": { "query": "zo", "tokens": [] },
        "effect": { "query": "zo", "tokens": [] }
      },
      {
        "name": "a tag that has gone since the menu was drawn is ignored",
        "action": "applySearchSuggestion",
        "payload": { "id": "tag:onboarding" },
        "before": { "query": "on", "tokens": [] },
        "effect": { "query": "on", "tokens": [] }
      },
      {
        "name": "a meaning change addresses the token by its person",
        "action": "setSearchTokenMode",
        "payload": { "subject": { "kind": "person", "code": "p3" }, "mode": "not" },
        "before": { "query": "", "tokens": [{ "kind": "person", "code": "p3", "names": ["Zoë Ng"], "mode": "said" }] },
        "effect": { "query": "", "tokens": [{ "kind": "person", "code": "p3", "names": ["Zoë Ng"], "mode": "not" }] }
      },
      {
        "name": "a meaning the subject cannot take is ignored",
        "action": "setSearchTokenMode",
        "payload": { "subject": { "kind": "person", "code": "p3" }, "mode": "tagged" },
        "before": { "query": "", "tokens": [{ "kind": "person", "code": "p3", "names": ["Zoë Ng"], "mode": "said" }] },
        "effect": { "query": "", "tokens": [{ "kind": "person", "code": "p3", "names": ["Zoë Ng"], "mode": "said" }] }
      },
      {
        "name": "remove matches a tag whatever its case",
        "action": "removeSearchToken",
        "payload": { "subject": { "kind": "tag", "name": "ZONING" } },
        "before": { "query": "", "tokens": [{ "kind": "tag", "name": "Zoning", "mode": "tagged" }] },
        "effect": { "query": "", "tokens": [] }
      },
      {
        "name": "clearing the field empties the text and every token, as Esc and the clear button do",
        "action": "clearSearch",
        "payload": {},
        "before": { "query": "zo", "tokens": [{ "kind": "tag", "name": "Zoning", "mode": "tagged" }] },
        "effect": { "query": "", "tokens": [] }
      },
      {
        "name": "a subject of a kind this SPA does not know is ignored",
        "action": "removeSearchToken",
        "payload": { "subject": { "kind": "session", "id": "s2" } },
        "before": { "query": "", "tokens": [{ "kind": "tag", "name": "Zoning", "mode": "tagged" }] },
        "effect": { "query": "", "tokens": [{ "kind": "tag", "name": "Zoning", "mode": "tagged" }] }
      }
    ]
  }
}
