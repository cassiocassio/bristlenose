          "suggestions": [
            { "kind": "text", "id": "text", "query": "zo", "count": 4 },
            { "kind": "person", "id": "person:p3", "code": "p3", "name": "👩‍💻 Zoë Ng", "count": 2 },
            { "kind": "person", "id": "person:p9", "code": "p9", "name": null, "count": 1 },
            { "kind": "tag", "id": "tag:zoning", "tag": { "name": "Zoning", "codebook_group": "", "colour_set": "", "colour_index": 0 }, "count": 1 }
          ]
        },
        "wire": {
          "query": "zo",
          "rows": [
            { "id": "text", "kind": "text", "label": "Quotes containing “zo”", "typed": [[19, 21]], "count": 4 },
            { "id": "person:p3", "kind": "person", "label": "👩‍💻 Zoë Ng", "typed": [[6, 8]], "count": 2, "code": "p3" },
            { "id": "person:p9", "kind": "person", "label": "p9", "typed": [], "count": 1, "code": "p9" },
            { "id": "tag:zoning", "kind": "tag", "label": "Zoning", "typed": [[0, 2]], "count": 1 }
          ]
        }
      },
      {
        "name": "an empty menu closes the native one",
        "input": { "query": "", "suggestions": [] },
        "wire": { "query": "", "rows": [] }
      }
    ],
    "quotes_filter_tokens": [
      {
        "name": "a person who can be mentioned, a code-only person, a tag; names cross unescaped",
        "input": [
          { "kind": "person", "code": "p3", "names": ["Zoë O'Brien <Ng>"], "mode": "mentions" },
          { "kind": "person", "code": "p9", "names": [], "mode": "said" },
          { "kind": "tag", "name": "Zoning", "mode": "not" }
        ],
        "wire": [
          {
            "kind": "person",
            "subject": { "kind": "person", "code": "p3" },
            "styleKey": "p3",
            "label": "Zoë O'Brien <Ng>",
            "mode": "mentions",
            "modes": [
              { "id": "said", "label": "Said by Zoë O'Brien <Ng>", "enabled": true },
              { "id": "mentions", "label": "Mentions Zoë O'Brien <Ng>", "enabled": true },
              { "id": "not", "label": "Not Zoë O'Brien <Ng>", "enabled": true }
            ]
          },
          {
            "kind": "person",
            "subject": { "kind": "person", "code": "p9" },
            "styleKey": "p9",
            "label": "p9",
            "mode": "said",
            "modes": [
              { "id": "said", "label": "Said by p9", "enabled": true },
              { "id": "mentions", "label": "Mentions p9", "enabled": false },
              { "id": "not", "label": "Not p9", "enabled": true }
            ]
          },
          {
            "kind": "tag",
            "subject": { "kind": "tag", "name": "Zoning" },
            "styleKey": "zoning",
            "label": "Zoning",
            "mode": "not",
            "modes": [
              { "id": "tagged", "label": "Tagged “Zoning”", "enabled": true },
              { "id": "contains", "label": "Text contains “Zoning”", "enabled": true },
