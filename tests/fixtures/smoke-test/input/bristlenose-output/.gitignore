# Rendered output — generated by smoke tests, not checked in
*.html
*.md
assets/
sessions/
people.yaml

# SQLite files created by bristlenose serve (E2E tests)
*.db
*.db-*

# Log written by bristlenose serve when test/E2E runs use this fixture
bristlenose.log

# The study marker and its Spotlight beacon, minted by the first serve or run
# that touches the fixture (bristlenose/study_marker.py)
study.json
bristlenose-study.txt

# The LLM call log: written into the fixture by a test run, and a re-identification key
# class file, so it is never committed (the root .gitignore says logs stay ignored here)
llm-calls.jsonl
