  "field_meanings": {
    "input_tokens": "input billed at the full rate: cache reads and cache writes are NOT in it, whatever the provider reports (OpenAI, Azure and Gemini count cached input inside their prompt count; the ledger moves that share to cache_read_input_tokens)",
    "output_tokens": "all billed output, thinking and reasoning included (Gemini reports thoughts apart; they are added in)",
    "cache_read_input_tokens": "input served from a provider cache, billed at its cache-read rate",
    "cache_creation_input_tokens": "input written to a provider cache, billed at its cache-write rate (Anthropic only)",
    "calls_without_usage": "calls the provider reported no usage for: counted in calls, with no tokens",
    "model": "the model the request named, exactly; never a response snapshot name",
    "ts": "UTC, when the job ended and its row was written; the day a row is priced at"
  },
  "progress_fields": {
    "_doc": "Optional fields on run_progress lines in pipeline-events.jsonl: a running pipeline run's use so far, summed over its models, with the ledger's field meanings. Distinct from a terminus's input_tokens/output_tokens, which are the provider's own counts. Absent before the run's first LLM call and from an older sidecar.",
